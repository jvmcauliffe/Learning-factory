{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SAA-C03 multiple-choice question file",
  "description": "A file of candidate questions. Every answer and every explanation is tied to a line of a guide in content/saa-c03/ (RonitSachdev/aws-saa-c03-guides, CC BY 4.0, https://github.com/RonitSachdev/aws-saa-c03-guides). Status starts as candidate; only John sets verified.",
  "type": "object",
  "required": ["questions"],
  "additionalProperties": false,
  "properties": {
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/question" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["guide", "line"],
      "additionalProperties": false,
      "properties": {
        "guide": { "type": "string", "pattern": "^content/saa-c03/[0-9]{2}-[A-Za-z0-9-]+\\.md$" },
        "line": { "type": "integer", "minimum": 1 }
      }
    },
    "option": {
      "type": "object",
      "required": ["text", "explanation", "source"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "explanation": { "type": "string", "minLength": 10 },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "question": {
      "type": "object",
      "required": ["id", "guide", "stem", "options", "correct", "domain", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^q[0-9]{4}$" },
        "guide": { "type": "string", "pattern": "^content/saa-c03/[0-9]{2}-[A-Za-z0-9-]+\\.md$" },
        "stem": { "type": "string", "minLength": 20 },
        "options": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/option" } },
        "correct": { "type": "integer", "minimum": 0, "maximum": 3 },
        "domain": { "type": "string", "enum": ["domain-1", "domain-2", "domain-3", "domain-4"] },
        "status": { "type": "string", "enum": ["candidate", "verified"] }
      }
    }
  }
}
